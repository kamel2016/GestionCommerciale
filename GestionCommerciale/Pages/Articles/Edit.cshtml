@page "/Articles/Edit/{id:int}"
@model GestionCommerciale.Pages.Articles.EditModel
@{
    ViewData["Title"] = "Modifier l'article";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="~/css/article-edit.css" rel="stylesheet" asp-append-version="true" />

<div class="article-container">
    <div class="article-header">
        <div>
            <h1><i class="fas fa-box"></i> Modifier l'article</h1>
            <div class="header-info">
                <span>ID: @Model.Article.ID | Réf: @Model.Article.Reference | Code-barre: @Model.Article.CodeBarre</span>
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="fas fa-trash"></i> Supprimer
            </button>
            <a asp-page="./Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="close">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="close">&times;</button>
        </div>
    }

    <div class="tabs-container">
        <div class="tabs-nav">
            <button type="button" class="tab-btn active" data-tab="general"><i class="fas fa-info-circle"></i> Général</button>
            <button type="button" class="tab-btn" data-tab="description"><i class="fas fa-align-left"></i> Description</button>
            <button type="button" class="tab-btn" data-tab="pricing"><i class="fas fa-tag"></i> Tarification Fournisseurs</button>
            <button type="button" class="tab-btn" data-tab="stock"><i class="fas fa-warehouse"></i> Stock</button>
            <button type="button" class="tab-btn" data-tab="system"><i class="fas fa-cog"></i> Système</button>
        </div>

        @* ===== FORMULAIRE PRINCIPAL : Général + Description + Stock min/max ===== *@
        <form method="post" id="articleForm">
            <input type="hidden" asp-for="Article.ID" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="tab-content active" id="general">
                <h3>Informations Générales</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Article.Reference" class="required"></label>
                        <input asp-for="Article.Reference" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Article.Reference" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.CodeBarre"></label>
                        <input asp-for="Article.CodeBarre" class="form-control" autocomplete="off" />
                        @* <span asp-validation-for="Article.CodeBarre" class="field-error"></span> *@
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.Libelle" class="required"></label>
                        <input asp-for="Article.Libelle" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Article.Libelle" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.CategoryId"></label>
                        <select asp-for="Article.CategoryId" asp-items="Model.Categories" class="form-control"></select>
                        <span asp-validation-for="Article.CategoryId" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.Unite" class="required"></label>
                        <select asp-for="Article.Unite" asp-items="Model.Units" class="form-control"></select>
                        <span asp-validation-for="Article.Unite" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.PrixAchatHT" class="required"></label>
                        <input asp-for="Article.PrixAchatHT" type="number" step="0.001" min="0" class="form-control" />
                        <span asp-validation-for="Article.PrixAchatHT" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.PrixVenteHT" class="required"></label>
                        <input asp-for="Article.PrixVenteHT" type="number" step="0.001" min="0" class="form-control" />
                        <span asp-validation-for="Article.PrixVenteHT" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.TauxTVA"></label>
                        <input asp-for="Article.TauxTVA" type="number" min="0" max="100" step="0.01" class="form-control" />
                        <span asp-validation-for="Article.TauxTVA" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.PrixVenteTTC" class="required"></label>
                        <input asp-for="Article.PrixVenteTTC" type="number" step="0.001" min="0" class="form-control" />
                        <span asp-validation-for="Article.PrixVenteTTC" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label>Marge HT</label>
                        <div class="info-value">
                            @Model.Article.MargeHT.ToString("N3") DT
                            <span class="badge badge-success">@Model.Article.MargePourcentage.ToString("N2") %</span>
                        </div>
                    </div>
                </div>

                <div class="form-check mt-3">
                    <input asp-for="Article.Fodec" type="checkbox" class="form-check-input" id="fodecCheck" />
                    <label for="fodecCheck" class="form-check-label">Soumis au FODEC (1 %)</label>
                </div>
                <div class="form-check mt-2">
                    <input asp-for="Article.EstActif" type="checkbox" class="form-check-input" id="isActiveCheck" />
                    <label for="isActiveCheck" class="form-check-label">Article actif</label>
                </div>
            </div>

            <div class="tab-content" id="description">
                <h3>Description et Détails</h3>
                <div class="form-grid">
                    <div class="form-group" style="grid-column: 1 / -1;">
                        <label asp-for="Article.Description"></label>
                        <textarea asp-for="Article.Description" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Article.Description" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.Marque"></label>
                        <input asp-for="Article.Marque" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.Modele"></label>
                        <input asp-for="Article.Modele" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.Couleur"></label>
                        <input asp-for="Article.Couleur" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.Taille"></label>
                        <input asp-for="Article.Taille" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.Poids"></label>
                        <input asp-for="Article.Poids" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Article.Poids" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="tab-content" id="stock">
                <h3>Gestion du Stock</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Article.StockMin"></label>
                        <input asp-for="Article.StockMin" type="number" min="0" step="1" class="form-control" />
                        <span asp-validation-for="Article.StockMin" class="field-error"></span>
                        <small class="form-text">Alerte si le stock passe en dessous</small>
                    </div>
                    <div class="form-group">
                        <label asp-for="Article.StockMax"></label>
                        <input asp-for="Article.StockMax" type="number" min="0" step="1" class="form-control" />
                        <span asp-validation-for="Article.StockMax" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label>Stock actuel (lecture seule)</label>
                        <div class="info-value">
                            @Model.Article.Quantite <span class="unit">@Model.Article.Unite</span>
                            @if (Model.Article.EnRuptureDeStock)
                            {
                                <span class="badge badge-danger">Sous le minimum</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="pricing-controls">
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#stockModal">
                        <i class="fas fa-plus"></i> Nouveau mouvement
                    </button>
                </div>

                <div class="suppliers-table-wrapper">
                    <table class="suppliers-table">
                        <thead>
                            <tr><th>Date</th><th>Type</th><th>Quantité</th><th>Stock après</th><th>Commentaire</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Mouvements)
                            {
                                <tr>
                                    <td data-label="Date">@m.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td data-label="Type">@m.Type</td>
                                    <td data-label="Quantité">@m.Quantite.ToString("+0;-0")</td>
                                    <td data-label="Stock après">@m.QuantiteApres</td>
                                    <td data-label="Commentaire">@m.Commentaire</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!Model.Mouvements.Any())
                    {
                        <div class="empty-state"><i class="fas fa-inbox"></i><p>Aucun mouvement de stock</p></div>
                    }
                </div>
            </div>

            <div class="tab-content" id="system">
                <h3>Informations Système</h3>
                <div class="info-card">
                    <div class="info-item"><label>ID Article</label><span>@Model.Article.ID</span></div>
                    <div class="info-item"><label>Date de création</label><span>@Model.Article.DateCreation.ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="info-item">
                        <label>Dernière modification</label>
                        <span>
                            @if (Model.Article.DateModification != null)
                            {
                                @Model.Article.DateModification.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </span>
                    </div>
                    <div class="info-item">
                        <label>Statut</label>
                        <span><span class="badge @(Model.Article.EstActif ? "badge-success" : "badge-danger")">@(Model.Article.EstActif ? "Actif" : "Inactif")</span></span>
                    </div>
                </div>
            </div>

            <div class="action-buttons">
                <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Sauvegarder l'article</button>
                <a asp-page="./Index" class="btn btn-secondary"><i class="fas fa-times"></i> Annuler</a>
            </div>
        </form>

        @* ===== ONGLET FOURNISSEURS (hors formulaire principal) ===== *@
        <div class="tab-content" id="pricing">
            <h3>Tarification par Fournisseur</h3>
            <div class="pricing-controls">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
                    <i class="fas fa-plus"></i> Ajouter un fournisseur
                </button>
            </div>

            <div class="suppliers-table-wrapper">
                <table class="suppliers-table">
                    <thead>
                        <tr>
                            <th>Fournisseur</th>
                            <th>Prix Gros HT</th>
                            <th>Prix Détail HT</th>
                            <th>Prix Promo HT</th>
                            <th>Marge Détail</th>
                            <th>Remise Max</th>
                            <th>Dernier Achat</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.SupplierPricings)
                        {
                            var marge = s.PrixGrosHT > 0 ? (s.PrixDetailHT - s.PrixGrosHT) / s.PrixGrosHT * 100 : 0;
                            <tr>
                                <td data-label="Fournisseur"><strong>@s.Fournisseur.Nom</strong></td>
                                <td data-label="Prix Gros HT">@s.PrixGrosHT.ToString("N3") DT</td>
                                <td data-label="Prix Détail HT">@s.PrixDetailHT.ToString("N3") DT</td>
                                <td data-label="Prix Promo HT">
                                    @if (s.PrixPromoHT > 0)
                                    {
                                        <span class="price-badge promo">@s.PrixPromoHT.Value.ToString("N3") DT</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td data-label="Marge Détail"><span class="margin-badge">@marge.ToString("N1") %</span></td>
                                <td data-label="Remise Max">@s.RemiseMax.ToString("N1") %</td>
                                <td data-label="Dernier Achat">@(s.DernierAchat?.ToString("dd/MM/yyyy") ?? "Jamais")</td>
                                <td data-label="Actions">
                                    <form method="post" asp-page-handler="RemoveSupplier" asp-route-supplierId="@s.FournisseurId"
                                          style="display:inline"
                                          onsubmit="return confirm('Retirer ce fournisseur ?');">
                                        <input type="hidden" name="Article.ID" value="@Model.Article.ID" />
                                        <button type="submit" class="btn-link btn-remove" title="Retirer"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.SupplierPricings.Any())
                {
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>Aucun fournisseur défini pour cet article</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ===== MODAL : AJOUT FOURNISSEUR ===== *@
<div class="modal fade" id="addSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="AddSupplier" class="modal-content">
            <input type="hidden" name="Article.ID" value="@Model.Article.ID" />
            <div class="modal-header">
                <h5 class="modal-title">Ajouter un fournisseur</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Fournisseur</label>
                    <select asp-for="NewSupplier.FournisseurId" asp-items="Model.AvailableSuppliers" class="form-control" required>
                        <option value="">-- Sélectionner un fournisseur --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Prix Gros HT (DT)</label>
                    <input asp-for="NewSupplier.PrixGrosHT" type="number" step="0.001" min="0" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Prix Détail HT (DT)</label>
                    <input asp-for="NewSupplier.PrixDetailHT" type="number" step="0.001" min="0" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Prix Promo HT (optionnel)</label>
                    <input asp-for="NewSupplier.PrixPromoHT" type="number" step="0.001" min="0" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Remise max (%)</label>
                    <input asp-for="NewSupplier.RemiseMax" type="number" step="0.1" min="0" max="100" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-success">Ajouter</button>
            </div>
        </form>
    </div>
</div>

@* ===== MODAL : MOUVEMENT DE STOCK ===== *@
<div class="modal fade" id="stockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="AddStockMovement" class="modal-content">
            <input type="hidden" name="Article.ID" value="@Model.Article.ID" />
            <div class="modal-header">
                <h5 class="modal-title">Nouveau mouvement de stock</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Type</label>
                    <select asp-for="NewStock.Type" class="form-control">
                        <option value="Entrée">Entrée</option>
                        <option value="Sortie">Sortie</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Quantité</label>
                    <input asp-for="NewStock.Quantite" type="number" step="1" min="1" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>Commentaire</label>
                    <input asp-for="NewStock.Commentaire" class="form-control" maxlength="250" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-success">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@* ===== MODAL : SUPPRESSION ===== *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                Supprimer définitivement l'article <strong>@Model.Article.Libelle</strong> ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="post" asp-page-handler="Delete" style="display:inline">
                    <input type="hidden" name="Article.ID" value="@Model.Article.ID" />
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/article-edit.js" asp-append-version="true"></script>
}