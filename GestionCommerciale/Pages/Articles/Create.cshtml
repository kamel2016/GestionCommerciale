@page "/Articles/Create"
@model GestionCommerciale.Pages.Articles.CreateModel
@{
    ViewData["Title"] = "Créer un article";
}

<link href="~/css/article-create.css" rel="stylesheet" asp-append-version="true" />

<div class="article-container">
    <div class="article-header">
        <div class="header-info">
            <h1>Créer un article</h1>
        </div>
    </div>

    <div class="tabs-container">
        <div class="tab-content active">
            <form method="post" id="createArticleForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Article.Reference" class="required"></label>
                        <input asp-for="Article.Reference" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Article.Reference" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Article.CodeBarre"></label>
                        <input asp-for="Article.CodeBarre" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Article.CodeBarre" class="field-validation-error"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Article.Libelle" class="required"></label>
                        <input asp-for="Article.Libelle" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Article.Libelle" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Article.CategoryId" class="required"></label>
                        <select asp-for="Article.CategoryId" asp-items="Model.Categories" class="form-control">
                            <option value="">-- Sélectionner une catégorie --</option>
                        </select>
                        <span asp-validation-for="Article.CategoryId" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Article.Unite"></label>
                        <select asp-for="Article.Unite" asp-items="Model.Units" class="form-control"></select>
                        <span asp-validation-for="Article.Unite" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Article.TauxTVA"></label>
                        <input asp-for="Article.TauxTVA" type="number" min="0" max="100" step="0.01" class="form-control" />
                        <span asp-validation-for="Article.TauxTVA" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Article.StockMin"></label>
                        <input asp-for="Article.StockMin" type="number" min="0" step="1" class="form-control" />
                        <span asp-validation-for="Article.StockMin" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Article.StockMax"></label>
                        <input asp-for="Article.StockMax" type="number" min="0" step="1" class="form-control" />
                        <span asp-validation-for="Article.StockMax" class="field-validation-error"></span>
                    </div>

                    <div class="form-group full-width">
                        <div class="form-check">
                            <input asp-for="Article.EstActif" type="checkbox" class="form-check-input" />
                            <label asp-for="Article.EstActif" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <div class="action-buttons">
                    <button type="submit" class="btn btn-success">Créer l'article</button>
                    <a asp-page="./Index" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/article-create.js" asp-append-version="true"></script>
}