@page "{id:int}"
@model GestionCommerciale.Pages.Categories.DetailsModel
@{
    ViewData["Title"] = "Détails de l'article";
}

<div class="container fade-in">
    <h1>Détails de la catégorie</h1>

    @if (Model.Categorie != null)
    {
        <div class="details-container">

            <div class="details-row">
                <div class="details-label">@Html.DisplayNameFor(model => model.Categorie.Libelle)</div>
                <div class="details-value">@Html.DisplayFor(model => model.Categorie.Libelle)</div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-page="Edit" asp-route-id="@Model.Categorie.ID" class="btn btn-primary">
                <i class="fas fa-edit"></i>
                Modifier
            </a>
            <a asp-page="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Retour à la liste
            </a>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>Article introuvable</h3>
            <p>L'article demandé n'existe pas.</p>
            <a asp-page="Index" class="btn btn-secondary">Retour à la liste</a>
        </div>
    }
</div>