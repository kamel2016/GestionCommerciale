@page
@model GestionCommerciale.Pages.Categories.IndexModel
@{
    ViewBag.Title = "Liste des catégories";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container fade-in">
    <h1>Liste des categories</h1>

    <!-- Bouton Nouvel Article -->
    <div class="mb-4">
        <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Nouvelle Catégorie
        </a>
    </div>

    <!-- Barre de recherche -->
    <div class="search-container">
        <form method="get" class="search-form">
            <div class="search-input">
                <input type="text" name="Filtre" value="@Model.Filtre" class="form-control" placeholder="Rechercher par référence, libellé ou code barre..." />
            </div>
            <button type="submit" class="btn btn-secondary">
                <i class="fas fa-search"></i>
                Rechercher
            </button>
        </form>
    </div>

    <!-- Tableau des articles -->
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Categories.First().Libelle)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categories != null && Model.Categories.Any())
                {
                    foreach (var item in Model.Categories)
                    {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Libelle)</td>
                                    <td>
                                        <div class="table-actions">
                                            <a asp-page="Edit" asp-route-id="@item.ID" class="action-edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-page="Details" asp-route-id="@item.ID" class="action-details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-page="Delete" asp-route-id="@item.ID" class="action-delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                    }
                }
                else
                {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <h3>Aucun article trouvé</h3>
                                <p>Essayez de modifier vos critères de recherche</p>
                            </td>
                        </tr>
                }
            </tbody>
        </table>
    </div>
</div>