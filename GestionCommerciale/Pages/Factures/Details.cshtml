@page "{id:int}"
@model GestionCommerciale.Pages.Factures.DetailsModel
@using GestionCommerciale.Enums
@{
    ViewData["Title"] = "Facture";

    var f = Model.Facture;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        Facture @(string.IsNullOrEmpty(f.Numero) ? "(brouillon)" : f.Numero)
        @switch (f.Statut)

        {

            case StatutFacture.Brouillon:
                <span class="badge bg-secondary">Brouillon</span>
                break;

            case StatutFacture.Validee:
                <span class="badge bg-success">Validée</span>
                break;

            case StatutFacture.Annulee:
                <span class="badge bg-danger">Annulée</span>
                break;

        }
    </h2>
    <div class="d-flex gap-2">
        <a asp-page="Index" class="btn btn-outline-secondary">Retour</a>

        @if (f.Statut == StatutFacture.Brouillon)

        {
            <form method="post" asp-page-handler="Valider" asp-route-id="@f.Id"
                  onsubmit="return confirm('Valider cette facture ? Un numéro définitif sera attribué.');">
                <button type="submit" class="btn btn-success">Valider</button>
            </form>
        }
        @if (f.Statut != StatutFacture.Annulee)

        {
            <form method="post" asp-page-handler="Annuler" asp-route-id="@f.Id"
                  onsubmit="return confirm('Annuler cette facture ?');">
                <button type="submit" class="btn btn-danger">Annuler</button>
            </form>
        }
        <a asp-page="Pdf" asp-route-id="@Model.Facture.Id" target="_blank"
           class="btn btn-outline-dark">Imprimer PDF</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))

{
    <div class="alert alert-success">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.Erreur))

{
    <div class="alert alert-danger">@Model.Erreur</div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Client</div>
            <div class="card-body">
                <strong>@f.Client?.Nom</strong>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Informations</div>
            <div class="card-body">
                <div>Date : @f.Date.ToString("dd/MM/yyyy")</div>
                @if (f.BonLivraisonId != null)

                {
                    <div>Bon de livraison : n° @f.BonLivraisonId</div>
                }
            </div>
        </div>
    </div>
</div>

<table class="table table-bordered table-sm">
    <thead class="table-light">
        <tr>
            <th>Désignation</th>
            <th class="text-end">Qté</th>
            <th class="text-end">PU HT</th>
            <th class="text-end">Remise %</th>
            <th class="text-end">TVA %</th>
            <th class="text-end">Total HT</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in f.Lignes)

        {
            <tr>
                <td>@l.Designation</td>
                <td class="text-end">@l.Quantite.ToString("N2")</td>
                <td class="text-end">@l.PrixUnitaireHt.ToString("N3")</td>
                <td class="text-end">@l.RemisePourcent.ToString("N2")</td>
                <td class="text-end">@l.TauxTva.ToString("N2")</td>
                <td class="text-end">@l.TotalHt.ToString("N3")</td>
            </tr>
        }
    </tbody>
</table>

<div class="row justify-content-end">
    <div class="col-md-5">
        <table class="table table-sm">
            @if (f.RemiseGlobalePourcent > 0)
            {
                <tr><td>Remise globale</td><td class="text-end">@f.RemiseGlobalePourcent.ToString("N2") %</td></tr>
            }
            <tr><td>Total HT</td><td class="text-end">@f.TotalHt.ToString("N3")</td></tr>
            @if (f.MontantFodec > 0)
            {
                <tr><td>FODEC</td><td class="text-end">@f.MontantFodec.ToString("N3")</td></tr>
            }
            <tr><td>Total TVA</td><td class="text-end">@f.TotalTva.ToString("N3")</td></tr>
            <tr><td>Timbre fiscal</td><td class="text-end">@f.TimbreFiscal.ToString("N3")</td></tr>
            <tr class="fw-bold"><td>Total TTC</td><td class="text-end">@f.TotalTtc.ToString("N3")</td></tr>
            @if (f.RetenueSourceApplicable)
            {
                <tr><td>Retenue à la source</td><td class="text-end">- @f.MontantRetenueSource.ToString("N3")</td></tr>
            }
            <tr class="table-primary fw-bold"><td>Net à payer</td><td class="text-end">@f.NetAPayer.ToString("N3")</td></tr>
        </table>
    </div>
</div>