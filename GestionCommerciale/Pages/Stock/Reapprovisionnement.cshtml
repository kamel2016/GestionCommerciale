@page
@model TonProjet.Pages.Stock.ReapprovisionnementModel
@{
    ViewData["Title"] = "Articles à réapprovisionner";
}

<h1>Articles à réapprovisionner</h1>

@if (!Model.ArticlesAReapprovisionner.Any())
{
        <div class="alert alert-success">
            Aucun article sous le seuil de stock minimum.
        </div>
}
else
{
        <div class="alert alert-warning">
        @Model.ArticlesAReapprovisionner.Count article(s) sous le seuil de stock minimum.
        </div>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Libellé</th>
                    <th class="text-end">Stock actuel</th>
                    <th class="text-end">Stock minimum</th>
                    <th class="text-end">Manque</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model.ArticlesAReapprovisionner)
            {
                var manque = a.StockMin - a.Quantite;
                        <tr class="@(a.Quantite <= 0 ? "table-danger" : "table-warning")">
                            <td>@a.Libelle</td>
                            <td class="text-end">@a.Quantite</td>
                            <td class="text-end">@a.StockMin</td>
                            <td class="text-end">@(manque > 0 ? manque : 0)</td>
                            <td class="text-end">
                                <a asp-page="/Articles/Edit" asp-route-id="@a.ID" class="btn btn-sm btn-outline-primary">Article</a>
                                <a asp-page="/Stock/Mouvements" asp-route-ArticleId="@a.ID" class="btn btn-sm btn-outline-secondary">Historique</a>
                            </td>
                        </tr>
            }
            </tbody>
        </table>
}