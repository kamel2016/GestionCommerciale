@page
@model GestionCommerciale.Pages.Clients.IndexModel
@using GestionCommerciale.Models
@{
    ViewData["Title"] = "Gestion des Clients";
}

<link rel="stylesheet" href="~/css/client-index.css" asp-append-version="true" />

<div class="clients-container">

    <div class="clients-page-header">
        <div class="clients-title-section">
            <h1 class="clients-page-title">
                <i class="fas fa-users"></i> Gestion des Clients
            </h1>
            <div class="clients-header-info">
                <i class="fas fa-info-circle"></i>
                @Model.TotalClients client(s) • @Model.ActiveClients actif(s) • @Model.InactiveClients inactif(s)
            </div>
            <div class="clients-header-actions">
                <a asp-page="./Create" class="clients-btn-primary">
                    <i class="fas fa-plus"></i> Nouveau client
                </a>
                <button type="button" class="clients-btn-secondary" onclick="window.print()">
                    <i class="fas fa-print"></i> Imprimer
                </button>
            </div>
        </div>
    </div>

    <div class="clients-stats-grid">
        <div class="clients-stat-card">
            <div class="clients-stat-icon primary"><i class="fas fa-users"></i></div>
            <div class="clients-stat-value">@Model.TotalClients</div>
            <div class="clients-stat-label">Total clients</div>
        </div>
        <div class="clients-stat-card">
            <div class="clients-stat-icon success"><i class="fas fa-check-circle"></i></div>
            <div class="clients-stat-value">@Model.ActiveClients</div>
            <div class="clients-stat-label">Clients actifs</div>
        </div>
        <div class="clients-stat-card">
            <div class="clients-stat-icon warning"><i class="fas fa-pause-circle"></i></div>
            <div class="clients-stat-value">@Model.InactiveClients</div>
            <div class="clients-stat-label">Clients inactifs</div>
        </div>
        <div class="clients-stat-card">
            <div class="clients-stat-icon info"><i class="fas fa-building"></i></div>
            <div class="clients-stat-value">@Model.CompanyClients</div>
            <div class="clients-stat-label">Sociétés</div>
            <small>@Model.IndividualClients particulier(s)</small>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="clients-alert success"><i class="fas fa-check-circle"></i> @success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="clients-alert danger"><i class="fas fa-exclamation-circle"></i> @error</div>
    }

    <div class="clients-search-panel">
        <form method="get">
            <div class="clients-search-row">
                <div class="clients-search-input-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="SearchTerm" class="clients-search-input"
                           placeholder="Rechercher par nom, email, téléphone, ville..."
                           value="@Model.SearchTerm" />
                </div>
                <button type="submit" class="clients-btn-search">
                    <i class="fas fa-search"></i> Rechercher
                </button>
            </div>

            <div class="clients-filters-row">
                <div class="clients-filter-group">
                    <label for="FilterStatus">Statut</label>
                    <select name="FilterStatus" id="FilterStatus">
                        <option value="">Tous</option>
                        <option value="active" selected="@(Model.FilterStatus == "active" ? "selected" : null)">Actifs</option>
                        <option value="inactive" selected="@(Model.FilterStatus == "inactive" ? "selected" : null)">Inactifs</option>
                    </select>
                </div>

                <div class="clients-filter-group">
                    <label for="FilterType">Type</label>
                    <select name="FilterType" id="FilterType">
                        <option value="">Tous</option>
                        <option value="particulier" selected="@(Model.FilterType == "particulier" ? "selected" : null)">Particuliers</option>
                        <option value="societe" selected="@(Model.FilterType == "societe" ? "selected" : null)">Sociétés</option>
                    </select>
                </div>

                <div class="clients-filter-group">
                    <label for="FilterVille">Ville</label>
                    <select name="FilterVille" id="FilterVille">
                        <option value="">Toutes</option>
                        @foreach (var ville in Model.Villes)
                        {
                            <option value="@ville" selected="@(Model.FilterVille == ville ? "selected" : null)">@ville</option>
                        }
                    </select>
                </div>

                <div class="clients-filter-group">
                    <label for="SortBy">Trier par</label>
                    <select name="SortBy" id="SortBy">
                        <option value="name" selected="@(Model.SortBy == "name" ? "selected" : null)">Nom (A-Z)</option>
                        <option value="name_desc" selected="@(Model.SortBy == "name_desc" ? "selected" : null)">Nom (Z-A)</option>
                        <option value="type" selected="@(Model.SortBy == "type" ? "selected" : null)">Type</option>
                        <option value="ville" selected="@(Model.SortBy == "ville" ? "selected" : null)">Ville</option>
                        <option value="date_desc" selected="@(Model.SortBy == "date_desc" ? "selected" : null)">Date récente</option>
                        <option value="date" selected="@(Model.SortBy == "date" ? "selected" : null)">Date ancienne</option>
                    </select>
                </div>

                <div class="clients-filter-group">
                    <label for="PageSize">Résultats / page</label>
                    <select name="PageSize" id="PageSize" onchange="this.form.submit()">
                        <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25 ? "selected" : null)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
                    </select>
                </div>

                <input type="hidden" name="CurrentPage" value="1" />
                <button type="button" class="clients-btn-reset" onclick="window.location='@Url.Page("./Index")'">
                    <i class="fas fa-redo"></i> Réinitialiser
                </button>
            </div>
        </form>
    </div>

    <div class="clients-table-wrapper">
        <table class="clients-table">
            <thead>
                <tr>
                    <th>CLIENT</th>
                    <th>TYPE</th>
                    <th>CONTACT</th>
                    <th>VILLE</th>
                    <th>STATUT</th>
                    <th>CRÉÉ LE</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clients.Any())
                {
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td>
                                <div class="clients-name">
                                    <strong>@Model.GetClientName(client)</strong>
                                    @if (!string.IsNullOrWhiteSpace(client.MatriculeFiscale))
                                    {
                                        <small>@client.MatriculeFiscale</small>
                                    }
                                </div>
                            </td>
                            <td><span class="clients-type-badge">@Model.GetTypeText(client.TypeClient)</span></td>
                            <td>
                                <div class="clients-contact">
                                    @if (!string.IsNullOrWhiteSpace(client.Email))
                                    {
                                        <span><i class="fas fa-envelope"></i> @client.Email</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(client.Telephone))
                                    {
                                        <span><i class="fas fa-phone"></i> @client.Telephone</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(client.Mobile))
                                    {
                                        <span><i class="fas fa-mobile-alt"></i> @client.Mobile</span>
                                    }
                                </div>
                            </td>
                            <td>@(client.Ville ?? "—")</td>
                            <td>
                                <span class="@Model.GetStatusBadgeClass(client.EstActif)">
                                    <i class="@Model.GetStatusIcon(client.EstActif)"></i> @Model.GetStatusText(client.EstActif)
                                </span>
                            </td>
                            <td>@client.DateCreation.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="clients-action-buttons">
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@client.Id">
                                        <button type="submit" class="clients-icon-btn toggle"
                                                title="@(client.EstActif ? "Désactiver" : "Activer")">
                                            <i class="fas fa-power-off"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@client.Id"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce client ?');">
                                        <button type="submit" class="clients-icon-btn delete" title="Supprimer">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="clients-empty">
                            <i class="fas fa-users-slash"></i>
                            <p>Aucun client ne correspond aux critères.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="clients-pagination" aria-label="Pagination">
            <span>Page @Model.CurrentPage sur @Model.TotalPages</span>
            <div>
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a class="@(pageNumber == Model.CurrentPage ? "active" : "")"
                       asp-page="./Index"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-FilterStatus="@Model.FilterStatus"
                       asp-route-FilterType="@Model.FilterType"
                       asp-route-FilterVille="@Model.FilterVille"
                       asp-route-SortBy="@Model.SortBy"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-CurrentPage="@pageNumber">@pageNumber</a>
                }
            </div>
        </nav>
    }

</div>