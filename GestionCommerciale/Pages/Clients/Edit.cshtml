@page "/clients/edit/{id:int}"
@model GestionCommerciale.Pages.Clients.EditModel
@using GestionCommerciale.Enums
@using GestionCommerciale.Models
@{
    ViewData["Title"] = "Modifier le client";
}

<link href="~/css/client-form.css" rel="stylesheet" asp-append-version="true" />

<div class="clients-form-container">
    <div class="clients-form-header">
        <h1 class="clients-form-title">
            <i class="fas fa-user-edit"></i> Modifier le client
        </h1>
    </div>

    <form method="post" class="clients-form">
        <div asp-validation-summary="ModelOnly" class="clients-alert danger"></div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-info-circle"></i> Informations de base</h3>

            <div class="clients-form-group">
                <label asp-for="Client.TypeClient">Type de client</label>
                <select asp-for="Client.TypeClient" id="typeClient" class="form-select">
                    <option value="0">Particulier</option>
                    <option value="1">Société</option>
                </select>
                <span asp-validation-for="Client.TypeClient" class="clients-form-error"></span>
            </div>
            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label>Code client</label>
                    <input type="text" value="@Model.CodeClient" readonly disabled />
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.ModeFacturation">Mode de facturation</label>
                    @if (Model.ModeFacturationVerrouille)
                    {
                        @* Un champ désactivé n'est pas envoyé : on renvoie la valeur actuelle en champ caché. *@
                        <select asp-items="Html.GetEnumSelectList<ModeFacturation>()" class="form-select" disabled
                                asp-for="ModeFacturationActuel"></select>
                        <input type="hidden" name="Client.ModeFacturation" value="@((int)Model.ModeFacturationActuel)" />
                        <small class="clients-form-hint">
                            <i class="fas fa-lock"></i>
                            Modification impossible : ce client a déjà des documents
                            (commandes, devis, bons de livraison ou factures).
                        </small>
                    }
                    else
                    {
                        <select asp-for="Client.ModeFacturation"
                                asp-items="Html.GetEnumSelectList<ModeFacturation>()"
                                class="form-select"></select>
                    }
                    <span asp-validation-for="Client.ModeFacturation" class="clients-form-error"></span>
                </div>
            </div>
            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label asp-for="Client.Nom">Nom</label>
                    <input asp-for="Client.Nom" type="text" />
                    <span asp-validation-for="Client.Nom" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group" id="prenomGroup">
                    <label asp-for="Client.Prenom">Prénom</label>
                    <input asp-for="Client.Prenom" type="text" />
                    <span asp-validation-for="Client.Prenom" class="clients-form-error"></span>
                </div>
            </div>
            <div class="clients-form-group">
                <label>
                    <input asp-for="Client.EstActif" type="checkbox" /> Client actif
                </label>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-envelope"></i> Contact</h3>

            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label asp-for="Client.Email">Email</label>
                    <input asp-for="Client.Email" type="email" />
                    <span asp-validation-for="Client.Email" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.Telephone">Téléphone</label>
                    <input asp-for="Client.Telephone" type="tel" />
                    <span asp-validation-for="Client.Telephone" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.Mobile">Mobile</label>
                    <input asp-for="Client.Mobile" type="tel" />
                    <span asp-validation-for="Client.Mobile" class="clients-form-error"></span>
                </div>
            </div>

            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label asp-for="Client.Adresse">Adresse</label>
                    <input asp-for="Client.Adresse" type="text" />
                    <span asp-validation-for="Client.Adresse" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.Ville">Ville</label>
                    <input asp-for="Client.Ville" type="text" />
                    <span asp-validation-for="Client.Ville" class="clients-form-error"></span>
                </div>
            </div>

            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label asp-for="Client.CodePostal">Code postal</label>
                    <input asp-for="Client.CodePostal" type="text" inputmode="numeric" maxlength="4" placeholder="Ex: 1000" />
                    <span asp-validation-for="Client.CodePostal" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.Gouvernorat">Gouvernorat</label>
                    <select asp-for="Client.Gouvernorat">
                        <option value="">-- Sélectionner --</option>
                        @foreach (var gov in CreateModel.Gouvernorats)
                        {
                            <option value="@gov">@gov</option>
                        }
                    </select>
                    <span asp-validation-for="Client.Gouvernorat" class="clients-form-error"></span>
                </div>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-file-invoice"></i> Informations fiscales</h3>

            <div class="clients-form-group">
                <label asp-for="Client.MatriculeFiscale">Matricule fiscal</label>
                <input asp-for="Client.MatriculeFiscale" type="text" />
                <span asp-validation-for="Client.MatriculeFiscale" class="clients-form-error"></span>
            </div>

            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label>
                        <input asp-for="Client.SoumisRetenueSource" type="checkbox" /> Soumis à la retenue à la source
                    </label>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.TauxRetenueSource">Taux de retenue (%)</label>
                    <input asp-for="Client.TauxRetenueSource" type="number" step="0.01" min="0" max="100" />
                    <span asp-validation-for="Client.TauxRetenueSource" class="clients-form-error"></span>
                </div>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-handshake"></i> Conditions commerciales</h3>

            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label asp-for="Client.PlafondCredit">Plafond de crédit (DT)</label>
                    <input asp-for="Client.PlafondCredit" type="number" step="0.001" min="0" />
                    <span asp-validation-for="Client.PlafondCredit" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.DelaiPaiement">Délai de paiement (jours)</label>
                    <input asp-for="Client.DelaiPaiement" type="number" step="1" min="0" />
                    <span asp-validation-for="Client.DelaiPaiement" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.RemiseDefaut">Remise par défaut (%)</label>
                    <input asp-for="Client.RemiseDefaut" type="number" step="0.01" min="0" max="100" />
                    <span asp-validation-for="Client.RemiseDefaut" class="clients-form-error"></span>
                </div>
            </div>
        </div>

        <div class="clients-form-actions">
            <button type="submit" class="clients-btn-primary">
                <i class="fas fa-save"></i> Enregistrer
            </button>
            <a href="/clients" class="clients-btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-times"></i> Annuler
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const typeClient = document.getElementById('typeClient');
            const prenomGroup = document.getElementById('prenomGroup');

            function togglePrenom() {
                prenomGroup.style.display = typeClient.value === '1' ? 'none' : '';
            }

            typeClient.addEventListener('change', togglePrenom);
            togglePrenom();
        });
    </script>
}
