@page "/clients/details/{id:int?}"
@model GestionCommerciale.Pages.Clients.ClientDetailsModel
@using System.Globalization
@using GestionCommerciale.Enums
@using GestionCommerciale.Models
@{
    var c = Model.Fiche.Client;
    ViewData["Title"] = "Fiche client";
    var fr = CultureInfo.GetCultureInfo("fr-FR");

    string Montant(decimal valeur) => valeur.ToString("N3", fr) + " DT";
    string Texte(string? valeur) => string.IsNullOrWhiteSpace(valeur) ? "—" : valeur;
    string LibelleStatut(StatutCommande statut) => statut switch
    {
        StatutCommande.EnAttente => "En attente",
        StatutCommande.Confirmee => "Confirmée",
        StatutCommande.EnPreparation => "En préparation",
        StatutCommande.Expediee => "Expédiée",
        StatutCommande.Livree => "Livrée",
        StatutCommande.Annulee => "Annulée",
        _ => statut.ToString()
    };
}

<link href="~/css/client-form.css" rel="stylesheet" asp-append-version="true" />

<div class="clients-form-container">
    <div class="clients-form-header">
        <h1 class="clients-form-title">
            <i class="fas fa-user"></i> @c.NomComplet
        </h1>
        <p>
            Code @c.Code
            &nbsp;·&nbsp;
            @(c.TypeClient == TypeClient.Societe ? "Société" : "Particulier")
            &nbsp;·&nbsp;
            @(c.EstActif ? "Actif" : "Inactif")
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="clients-alert success">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="clients-form">
        <div class="clients-form-divider">
            <h3><i class="fas fa-info-circle"></i> Informations de base</h3>
            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label>Code client</label>
                    <input type="text" value="@c.Code" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Mode de facturation</label>
                    <input type="text" readonly disabled
                           value="@(c.ModeFacturation == ModeFacturation.EnCompte ? "Client en compte (BL + facture mensuelle)" : "Client passager (facture directe)")" />
                    @if (Model.Fiche.ModeFacturationVerrouille)
                    {
                        <small><i class="fas fa-lock"></i> Verrouillé : ce client a déjà des documents.</small>
                    }
                </div>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-envelope"></i> Contact</h3>
            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label>Email</label>
                    <input type="text" value="@Texte(c.Email)" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Téléphone</label>
                    <input type="text" value="@Texte(c.Telephone)" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Mobile</label>
                    <input type="text" value="@Texte(c.Mobile)" readonly disabled />
                </div>
            </div>
            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label>Adresse</label>
                    <input type="text" value="@Texte(c.Adresse)" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Ville</label>
                    <input type="text" value="@Texte(c.Ville)" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Code postal</label>
                    <input type="text" value="@Texte(c.CodePostal)" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Gouvernorat</label>
                    <input type="text" value="@Texte(c.Gouvernorat)" readonly disabled />
                </div>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-file-invoice"></i> Informations fiscales</h3>
            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label>Matricule fiscal</label>
                    <input type="text" value="@Texte(c.MatriculeFiscale)" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Retenue à la source</label>
                    <input type="text" readonly disabled
                           value="@(c.SoumisRetenueSource ? $"Oui, taux {c.TauxRetenueSource.ToString("0.##", fr)} %" : "Non")" />
                </div>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-handshake"></i> Conditions commerciales</h3>
            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label>Plafond de crédit</label>
                    <input type="text" value="@Montant(c.PlafondCredit)" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Délai de paiement</label>
                    <input type="text" value="@c.DelaiPaiement jours" readonly disabled />
                </div>
                <div class="clients-form-group">
                    <label>Remise par défaut</label>
                    <input type="text" value="@c.RemiseDefaut.ToString("0.##", fr) %" readonly disabled />
                </div>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-shopping-cart"></i> Commandes (@Model.Fiche.NombreCommandes)</h3>

            @if (Model.Fiche.DernieresCommandes.Count == 0)
            {
                <p>Aucune commande pour ce client.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Numéro</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th style="text-align:right">Total TTC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var commande in Model.Fiche.DernieresCommandes)
                        {
                            <tr>
                                <td>
                                    <a asp-page="/Commande_Client/Details" asp-route-id="@commande.Id">@commande.Numero</a>
                                </td>
                                <td>@commande.Date.ToString("dd/MM/yyyy", fr)</td>
                                <td>@LibelleStatut(commande.Statut)</td>
                                <td style="text-align:right">@Montant(commande.MontantTTC)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.Fiche.NombreCommandes > Model.Fiche.DernieresCommandes.Count)
                {
                    <small>Les @Model.Fiche.DernieresCommandes.Count dernières commandes sur @Model.Fiche.NombreCommandes.</small>
                }
            }
        </div>

        <div class="clients-form-divider">
            <small>
                Créé le @c.DateCreation.ToString("dd/MM/yyyy HH:mm", fr)
                @if (c.DateModification != null)
                {
                    <text>· Modifié le @c.DateModification.Value.ToString("dd/MM/yyyy HH:mm", fr)</text>
                }
            </small>
        </div>

        <div class="clients-form-actions">
            <a asp-page="./Edit" asp-route-id="@c.Id" class="clients-btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-edit"></i> Modifier
            </a>
            <a href="/clients" class="clients-btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>
