@page "{id:int}"
@model GestionCommerciale.Pages.Clients.DeleteModel

@{
    ViewData["Title"] = "Supprimer le client";
}

<h1>Supprimer le client</h1>

<h3>Êtes-vous sûr de vouloir supprimer ce client ?</h3>
<div>
    
    <hr />
  
    <div class="container fade-in">
        <div class="details-container">
            <div class="details-row">
                <div class="details-label">@Html.DisplayNameFor(model => model.Client.Nom)</div>
                <div class="details-value">@Html.DisplayFor(model => model.Client.Nom)</div>
            </div>

            <div class="details-row">
                <div class="details-label">@Html.DisplayNameFor(model => model.Client.Prenom)</div>
                <div class="details-value">@Html.DisplayFor(model => model.Client.Prenom)</div>
            </div>

            <div class="details-row">
                <div class="details-label">@Html.DisplayNameFor(model => model.Client.Email)</div>
                <div class="details-value">@Html.DisplayFor(model => model.Client.Email)</div>
            </div>

            <div class="details-row">
                <div class="details-label">@Html.DisplayNameFor(model => model.Client.Telephone)</div>
                <div class="details-value">@Html.DisplayFor(model => model.Client.Telephone)</div>
            </div>

            <div class="details-row">
                <div class="details-label">@Html.DisplayNameFor(model => model.Client.Adresse)</div>
                <div class="details-value">@Html.DisplayFor(model => model.Client.Adresse)</div>
            </div>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Client.Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-page="./Index">Retour à la liste</a>
    </form>
</div>