@page "/clients/create"
@model GestionCommerciale.Pages.Clients.CreateModel
@using GestionCommerciale.Models
@{
    ViewData["Title"] = "Nouveau client";
}

<link href="~/css/client-form.css" rel="stylesheet" asp-append-version="true" />

<div class="clients-form-container">
    <div class="clients-form-header">
        <h1 class="clients-form-title">
            <i class="fas fa-user-plus"></i> Nouveau client
        </h1>
    </div>

    <form method="post" class="clients-form">
        @if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
        {
            <div class="clients-alert danger">
                <i class="fas fa-exclamation-circle"></i>
                @ViewData["ErrorMessage"]
            </div>
        }

        <div class="clients-form-divider">
            <h3><i class="fas fa-info-circle"></i> Informations de base</h3>

            <div class="clients-form-group">
                <label asp-for="Client.TypeClient">Type de client</label>
                <select asp-for="Client.TypeClient" id="typeClient" class="form-select">
                    <option value="0">Particulier</option>
                    <option value="1">Société</option>
                </select>
                <span asp-validation-for="Client.TypeClient" class="clients-form-error"></span>
            </div>

            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label asp-for="Client.Nom">Nom</label>
                    <input asp-for="Client.Nom" type="text" placeholder="Ex: Dupont" />
                    <span asp-validation-for="Client.Nom" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group" id="prenomGroup">
                    <label asp-for="Client.Prenom">Prénom</label>
                    <input asp-for="Client.Prenom" type="text" placeholder="Ex: Jean" />
                    <span asp-validation-for="Client.Prenom" class="clients-form-error"></span>
                </div>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-envelope"></i> Contact</h3>

            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label asp-for="Client.Email">Email</label>
                    <input asp-for="Client.Email" type="email" placeholder="exemple@email.com" />
                    <span asp-validation-for="Client.Email" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.Telephone">Téléphone</label>
                    <input asp-for="Client.Telephone" type="tel" placeholder="Ex: +216 XX XXX XXX" />
                    <span asp-validation-for="Client.Telephone" class="clients-form-error"></span>
                </div>
            </div>

            <div class="clients-form-row">
                <div class="clients-form-group">
                    <label asp-for="Client.Adresse">Adresse</label>
                    <input asp-for="Client.Adresse" type="text" placeholder="Ex: 123 rue de la Paix" />
                    <span asp-validation-for="Client.Adresse" class="clients-form-error"></span>
                </div>

                <div class="clients-form-group">
                    <label asp-for="Client.Gouvernorat">Gouvernorat</label>
                    <select asp-for="Client.Gouvernorat">
                        <option value="">-- Sélectionner --</option>
                        @foreach (var gov in CreateModel.Gouvernorats)
                        {
                            <option value="@gov">@gov</option>
                        }
                    </select>
                    <span asp-validation-for="Client.Gouvernorat" class="clients-form-error"></span>
                </div>
            </div>
        </div>

        <div class="clients-form-divider">
            <h3><i class="fas fa-file-invoice"></i> Informations fiscales</h3>

            <div class="clients-form-group">
                <label asp-for="Client.MatriculeFiscale">Matricule fiscal</label>
                <input asp-for="Client.MatriculeFiscale" type="text" placeholder="Ex: 12345678" />
                <span asp-validation-for="Client.MatriculeFiscale" class="clients-form-error"></span>
            </div>
        </div>

        <div class="clients-form-actions">
            <button type="submit" class="clients-btn-primary">
                <i class="fas fa-save"></i> Enregistrer
            </button>
            <a href="/clients" class="clients-btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-times"></i> Annuler
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const typeClient = document.getElementById('typeClient');
            const prenomGroup = document.getElementById('prenomGroup');

            function togglePrenom() {
                prenomGroup.style.display = typeClient.value === '1' ? 'none' : '';
            }

            typeClient.addEventListener('change', togglePrenom);
            togglePrenom();
        });
    </script>
}