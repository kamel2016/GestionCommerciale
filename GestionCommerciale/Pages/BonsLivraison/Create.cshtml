@* Pages/BonsLivraison/Create.cshtml *@
@page
@model GestionCommerciale.Pages.BonsLivraison.CreateModel
@{
    ViewData["Title"] = "Nouveau bon de livraison";
}

<h2>Nouveau bon de livraison</h2>
@if (Model.NumeroCommande != null)
{
    <p class="text-muted">Depuis la commande <strong>@Model.NumeroCommande</strong></p>
}

@if (!Model.CommandeClientId.HasValue)
{
    <p class="text-muted">Choisissez la commande à livrer. Seules les commandes Confirmées, En préparation ou Expédiées qui ont encore du reste à livrer sont proposées.</p>
    @if (!Model.CommandesEligibles.Any())
    {
        <div class="alert alert-info">
            Aucune commande éligible (statut Confirmée, En préparation ou Expédiée, avec du reste à livrer).
        </div>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>N° commande</th>
                    <th>Date</th>
                    <th>Client</th>
                    <th>Statut</th>
                    <th class="text-end">Lignes à livrer</th>
                    <th class="text-end">Reste total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.CommandesEligibles)
                {
                    <tr>
                        <td>@c.NumeroCommande</td>
                        <td>@c.DateCommande.ToString("dd/MM/yyyy")</td>
                        <td>@c.NomClient</td>
                        <td>@GestionCommerciale.Services.BonLivraisonService.LibelleStatutCommande(c.Statut)</td>
                        <td class="text-end">@c.NombreLignesAvecReste</td>
                        <td class="text-end">@c.ResteTotal</td>
                        <td class="text-end">
                            <a asp-page="Create" asp-route-commandeId="@c.Id" class="btn btn-sm btn-success">Créer un BL</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <a asp-page="Index" class="btn btn-secondary">Retour à la liste des BL</a>
}
else
{
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="CommandeClientId" />

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Client (celui de la commande)</label>
            <input type="text" class="form-control" value="@Model.NomClient" readonly />
        </div>
        <div class="col-md-3">
            <label class="form-label">Date</label>
            <input asp-for="Date" type="date" class="form-control" />
        </div>
    </div>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Article</th>
                <th class="text-end">Reste à livrer</th>
                <th class="text-end">Stock</th>
                <th style="width:140px">Qté à livrer</th>
                <th class="text-end">Prix unitaire</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Lignes.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Lignes[i].Designation
                        <input type="hidden" asp-for="Lignes[i].ArticleId" />
                        <input type="hidden" asp-for="Lignes[i].LigneCommandeClientId" />
                        <input type="hidden" asp-for="Lignes[i].Designation" />
                    </td>
                    <td class="text-end">
                        @Model.Lignes[i].QuantiteRestante
                        <input type="hidden" asp-for="Lignes[i].QuantiteRestante" />
                    </td>
                    <td class="text-end @(Model.Lignes[i].Stock < Model.Lignes[i].QuantiteRestante ? "text-danger fw-bold" : "")">
                        @Model.Lignes[i].Stock
                        <input type="hidden" asp-for="Lignes[i].Stock" />
                    </td>
                    <td>
                        <input asp-for="Lignes[i].Quantite" type="number" min="0"
                               max="@Math.Min(Model.Lignes[i].QuantiteRestante, Model.Lignes[i].Stock)"
                               class="form-control" />
                    </td>
                    <td class="text-end">@Model.Lignes[i].PrixUnitaire.ToString("N3")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mb-3">
        <label class="form-label">Commentaire</label>
        <textarea asp-for="Commentaire" class="form-control" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer en brouillon</button>
    <a asp-page="Index" class="btn btn-secondary">Annuler</a>
</form>
}