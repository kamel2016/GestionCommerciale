@page
@model GestionCommerciale.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "Fournisseurs";
}

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0"><i class="fas fa-truck me-2"></i>Gestion des Fournisseurs</h1>
        <a asp-page="./Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Nouveau fournisseur
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistiques -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="text-muted small">Total</div>
                    <div class="fs-4 fw-bold">@Model.Stats.Total</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="text-muted small">Actifs</div>
                    <div class="fs-4 fw-bold text-success">@Model.Stats.Actifs</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="text-muted small">Inactifs</div>
                    <div class="fs-4 fw-bold text-secondary">@Model.Stats.Inactifs</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="text-muted small">Nouveaux ce mois</div>
                    <div class="fs-4 fw-bold text-primary">@Model.Stats.NouveauxCeMois</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres -->
    <form method="get" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Recherche</label>
                <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control"
                       placeholder="Nom, matricule, contact, email, ville..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Statut</label>
                <select name="StatusFilter" class="form-select">
                    <option value="all" selected="@(Model.StatusFilter == "all")">Tous</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Actifs</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactifs</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Gouvernorat</label>
                <select name="GouvernoratFilter" class="form-select">
                    <option value="">Tous</option>
                    @foreach (var o in Model.GouvernoratOptions)
                    {
                        <option value="@o.Value" selected="@o.Selected">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1">Par page</label>
                <select name="pageSize" class="form-select">
                    @foreach (var o in Model.PageSizeOptions)
                    {
                        <option value="@o.Value" selected="@o.Selected">@o.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="fas fa-search"></i></button>
                <a asp-page="./Index" class="btn btn-outline-secondary flex-fill"><i class="fas fa-undo"></i></a>
            </div>
        </div>
        <input type="hidden" name="SortBy" value="@Model.SortBy" />
        <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
    </form>

    <!-- Tableau -->
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th><a href="@Model.GetSortUrl("id")" class="text-decoration-none text-dark">N° <i class="@Model.GetSortIcon("id")"></i></a></th>
                        <th><a href="@Model.GetSortUrl("name")" class="text-decoration-none text-dark">Raison sociale <i class="@Model.GetSortIcon("name")"></i></a></th>
                        <th><a href="@Model.GetSortUrl("contact")" class="text-decoration-none text-dark">Contact <i class="@Model.GetSortIcon("contact")"></i></a></th>
                        <th><a href="@Model.GetSortUrl("city")" class="text-decoration-none text-dark">Ville <i class="@Model.GetSortIcon("city")"></i></a></th>
                        <th><a href="@Model.GetSortUrl("gouvernorat")" class="text-decoration-none text-dark">Gouvernorat <i class="@Model.GetSortIcon("gouvernorat")"></i></a></th>
                        <th class="text-end"><a href="@Model.GetSortUrl("delai")" class="text-decoration-none text-dark">Livraison (j) <i class="@Model.GetSortIcon("delai")"></i></a></th>
                        <th class="text-end"><a href="@Model.GetSortUrl("paiement")" class="text-decoration-none text-dark">Paiement (j) <i class="@Model.GetSortIcon("paiement")"></i></a></th>
                        <th class="text-end"><a href="@Model.GetSortUrl("remise")" class="text-decoration-none text-dark">Remise <i class="@Model.GetSortIcon("remise")"></i></a></th>
                        <th class="text-center">Articles</th>
                        <th class="text-center">Commandes</th>
                        <th class="text-center">Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Fournisseurs.Any())
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">Aucun fournisseur trouvé.</td></tr>
                    }
                    @foreach (var f in Model.Fournisseurs)
                    {
                        <tr>
                            <td>#@f.Id</td>
                            <td>
                                <div class="fw-semibold">@f.Nom</div>
                                @if (!string.IsNullOrEmpty(f.MatriculeFiscale))
                                {
                                    <div class="small text-muted">MF : @f.MatriculeFiscale</div>
                                }
                            </td>
                            <td>
                                <div>@f.PersonneContact</div>
                                <div class="small text-muted">@f.Email</div>
                                <div class="small text-muted">@f.Telephone</div>
                            </td>
                            <td>@f.Ville</td>
                            <td>@f.Gouvernorat</td>
                            <td class="text-end">@f.DelaiLivraison</td>
                            <td class="text-end">@f.DelaiPaiement</td>
                            <td class="text-end">@f.RemiseAccordee.ToString("0.##") %</td>
                            <td class="text-center"><span class="badge bg-info text-dark">@f.ArticlesCount</span></td>
                            <td class="text-center"><span class="badge bg-secondary">@f.CommandesCount</span></td>
                            <td class="text-center">
                                @if (f.EstActif)
                                {
                                    <span class="badge bg-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactif</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-page="./Details" asp-route-id="@f.Id" class="btn btn-sm btn-outline-info" title="Détails"><i class="fas fa-eye"></i></a>
                                <a asp-page="./Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary" title="Modifier"><i class="fas fa-edit"></i></a>

                                <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@f.Id" class="d-inline"
                                      asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter"
                                      asp-route-GouvernoratFilter="@Model.GouvernoratFilter" asp-route-SortBy="@Model.SortBy"
                                      asp-route-SortOrder="@Model.SortOrder" asp-route-page="@Model.CurrentPage"
                                      asp-route-pageSize="@Model.PageSize">
                                    <button type="submit" class="btn btn-sm btn-outline-warning"
                                            title="@(f.EstActif ? "Désactiver" : "Activer")">
                                        <i class="fas @(f.EstActif ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                    </button>
                                </form>

                                <form method="post" asp-page-handler="Delete" asp-route-id="@f.Id" class="d-inline"
                                      asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter"
                                      asp-route-GouvernoratFilter="@Model.GouvernoratFilter" asp-route-SortBy="@Model.SortBy"
                                      asp-route-SortOrder="@Model.SortOrder" asp-route-page="@Model.CurrentPage"
                                      asp-route-pageSize="@Model.PageSize"
                                      onsubmit="return confirm('Supprimer le fournisseur « @f.Nom » ?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                @if (Model.TotalCount > 0)
                {
                    var from = (Model.CurrentPage - 1) * Model.PageSize + 1;
                    var to = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
                    <span>@from – @to sur @Model.TotalCount fournisseur(s)</span>
                }
                else
                {
                    <span>0 fournisseur</span>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                var start = Math.Max(1, Model.CurrentPage - 2);
                var end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Model.GetPageUrl(Model.CurrentPage - 1)">&laquo;</a>
                        </li>
                        @for (var p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Model.GetPageUrl(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Model.GetPageUrl(Model.CurrentPage + 1)">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>