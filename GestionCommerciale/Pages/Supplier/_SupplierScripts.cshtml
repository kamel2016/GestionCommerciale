@model GestionCommerciale.Pages.Suppliers.DetailsModel

<style>
    /* Même CSS que pour les clients */
    .simple-tab {
        background: #f8f9fa;
        border: 2px solid #ced4da;
        border-bottom: none;
        padding: 14px 24px 10px 24px;
        margin-right: 3px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        color: #495057;
        position: relative;
        transition: all 0.3s ease;
        border-radius: 12px 12px 0 0;
        box-shadow: 0 -3px 6px rgba(0,0,0,0.1);
        transform: translateY(2px);
        min-width: 130px;
        text-align: center;
    }

        .simple-tab::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            height: 4px;
            background: transparent;
            border-radius: 12px 12px 0 0;
            transition: all 0.3s ease;
        }

        .simple-tab:hover {
            background: #ffffff;
            color: #343a40;
            transform: translateY(-1px);
            box-shadow: 0 -6px 12px rgba(0,0,0,0.15);
            border-color: #adb5bd;
        }

            .simple-tab:hover::before {
                background: linear-gradient(90deg, #007bff, #0056b3);
                box-shadow: 0 0 8px rgba(0,123,255,0.4);
            }

        .simple-tab.active {
            background: #ffffff;
            color: #007bff;
            font-weight: 600;
            transform: translateY(-4px);
            border-color: #007bff;
            box-shadow: 0 -8px 16px rgba(0,123,255,0.2);
            z-index: 10;
        }

            .simple-tab.active::before {
                background: linear-gradient(90deg, #007bff, #0056b3);
            }
</style>