@page "/GoodsReceipt"
@model GestionCommerciale.Pages.GoodsReceipt.IndexModel
@{
    ViewData["Title"] = "Bons de réception";
}

<link rel="stylesheet" href="~/css/goods-receipt-index.css" asp-append-version="true" />

<div class="gr-page">

    <!-- En-tête -->
    <header class="gr-header">
        <div class="gr-header__title">
            <span class="gr-header__icon"><i class="fas fa-dolly"></i></span>
            <div>
                <h1>Bons de réception</h1>
                <p>Suivi des marchandises reçues auprès des fournisseurs</p>
            </div>
        </div>
        <a asp-page="Create" class="btn btn-gr-primary">
            <i class="fas fa-plus"></i> Nouveau bon
        </a>
    </header>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="gr-alert gr-alert--success" role="alert">
            <i class="fas fa-check-circle"></i> @success
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="gr-alert gr-alert--danger" role="alert">
            <i class="fas fa-exclamation-circle"></i> @error
        </div>
    }

    <!-- Filtres -->
    <form method="get" class="gr-filters">
        <div class="gr-filters__search">
            <i class="fas fa-search"></i>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm"
                   placeholder="Numéro, référence ou fournisseur…" />
        </div>

        <select name="Status" class="gr-select">
            <option value="">Tous les statuts</option>
            @foreach (var s in Model.StatutsDisponibles)
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>

        <input type="date" name="DateFrom" class="gr-input" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" title="Du" />
        <input type="date" name="DateTo" class="gr-input" value="@Model.DateTo?.ToString("yyyy-MM-dd")" title="Au" />

        <div class="gr-filters__actions">
            <button type="submit" class="btn btn-gr-primary"><i class="fas fa-filter"></i> Filtrer</button>
            <a asp-page="Index" class="btn btn-gr-ghost"><i class="fas fa-rotate-left"></i> Réinitialiser</a>
        </div>
    </form>

    <!-- Tableau -->
    <section class="gr-card">
        @if (Model.GoodsReceipts.Any())
        {
            <div class="table-responsive">
                <table class="gr-table">
                    <thead>
                        <tr>
                            <th>Numéro</th>
                            <th>Fournisseur</th>
                            <th>Réf. fournisseur</th>
                            <th>Date</th>
                            <th class="text-end">Montant HT</th>
                            <th class="text-end">Montant TTC</th>
                            <th>Statut</th>
                            <th>Créé par</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.GoodsReceipts)
                        {
                            <tr>
                                <td><span class="gr-code">@r.InternalNumber</span></td>
                                <td>
                                    <div class="gr-supplier">
                                        <span class="gr-supplier__name">@r.SupplierName</span>
                                        <small class="text-muted">@r.SupplierCode</small>
                                    </div>
                                </td>
                                <td>@r.SupplierReference</td>
                                <td>
                                    <div>@r.ReceiptDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@r.ReceiptTime.ToString(@"hh\:mm")</small>
                                </td>
                                <td class="text-end">@r.AmountExcludingTax.ToString("N2") €</td>
                                <td class="text-end"><strong>@r.AmountIncludingTax.ToString("N2") €</strong></td>
                                <td>
                                    <span class="gr-badge gr-badge--@r.Status.ToLower()">@r.Status</span>
                                </td>
                                <td><small>@r.CreatedBy</small></td>
                                <td>
                                    <div class="gr-actions">
                                        <button type="button" class="gr-icon-btn" title="Consulter"
                                                onclick="openReceiptPopup(@r.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        @if (r.Status == "Brouillon")
                                        {
                                            <a asp-page="Edit" asp-route-id="@r.Id" class="gr-icon-btn" title="Modifier">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                        }
                                        <button type="button" class="gr-icon-btn" title="Imprimer"
                                                onclick="printReceipt(@r.Id)">
                                            <i class="fas fa-print"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <footer class="gr-pagination">
                <span>
                    Page @Model.PageNumber / @Model.TotalPages · @Model.TotalRecords bon(s)
                </span>
                <nav>
                    <ul>
                        <li class="@(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a asp-page="Index" asp-route-PageNumber="@(Model.PageNumber - 1)"
                               asp-route-SearchTerm="@Model.SearchTerm" asp-route-Status="@Model.Status"
                               asp-route-DateFrom="@Model.DateFrom" asp-route-DateTo="@Model.DateTo">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                        {
                            <li class="@(i == Model.PageNumber ? "active" : "")">
                                <a asp-page="Index" asp-route-PageNumber="@i"
                                   asp-route-SearchTerm="@Model.SearchTerm" asp-route-Status="@Model.Status"
                                   asp-route-DateFrom="@Model.DateFrom" asp-route-DateTo="@Model.DateTo">@i</a>
                            </li>
                        }
                        <li class="@(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a asp-page="Index" asp-route-PageNumber="@(Model.PageNumber + 1)"
                               asp-route-SearchTerm="@Model.SearchTerm" asp-route-Status="@Model.Status"
                               asp-route-DateFrom="@Model.DateFrom" asp-route-DateTo="@Model.DateTo">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </footer>
        }
        else
        {
            <div class="gr-empty">
                <i class="fas fa-inbox"></i>
                <h3>Aucun bon de réception</h3>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.SearchTerm) && string.IsNullOrWhiteSpace(Model.Status)
                        ? "Créez votre premier bon pour commencer."
                        : "Aucun résultat pour ces critères.")
                </p>
                <a asp-page="Create" class="btn btn-gr-primary"><i class="fas fa-plus"></i> Créer un bon</a>
            </div>
        }
    </section>
</div>

<!-- Modal consultation -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content gr-modal">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-file-invoice"></i> Détail du bon</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body" id="receiptModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-gr-ghost" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-gr-primary" onclick="printReceiptFromModal()">
                    <i class="fas fa-print"></i> Imprimer
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/goods-receipt-index.js" asp-append-version="true"></script>
}