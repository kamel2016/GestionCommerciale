@page "{id:int}"
@using GestionCommerciale.Enums
@model GestionCommerciale.Pages.Commande_Client.EditModel
@{
    ViewData["Title"] = "Modifier la commande";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i>
                        Modifier la commande @Model.Input.NumeroCommande
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post" id="commandeForm">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Input.Id" />
                        <input type="hidden" asp-for="Input.NumeroCommande" />
                        <input type="hidden" asp-for="Input.DateCreation" />
                        <input type="hidden" asp-for="LignesJson" id="lignesJsonInput" />

                        <!-- Informations générales -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Numéro de commande</label>
                                    <input class="form-control" value="@Model.Input.NumeroCommande" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.DateCommande" class="form-label"></label>
                                    <input asp-for="Input.DateCommande" class="form-control" type="date" />
                                    <span asp-validation-for="Input.DateCommande" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.ClientId" class="form-label"></label>
                                    <select asp-for="Input.ClientId" asp-items="Model.ClientsList" class="form-select">
                                        <option value="">-- Sélectionner un client --</option>
                                    </select>
                                    <span asp-validation-for="Input.ClientId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.Statut" class="form-label"></label>
                                    <select asp-for="Input.Statut" asp-items="Html.GetEnumSelectList<StatutCommande>()" class="form-select"></select>
                                    <span asp-validation-for="Input.Statut" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.DateLivraison" class="form-label"></label>
                                    <input asp-for="Input.DateLivraison" class="form-control" type="date" />
                                    <span asp-validation-for="Input.DateLivraison" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Articles -->
                        <div class="card mb-4">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Articles</h5>
                                <button type="button" class="btn btn-primary btn-sm" onclick="openArticleModal()">
                                    <i class="fas fa-plus me-1"></i> Ajouter un article
                                </button>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Article</th>
                                                <th class="text-end">Quantité</th>
                                                <th class="text-end">Prix unitaire HT</th>
                                                <th class="text-end">Montant HT</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="articles-tbody"></tbody>
                                        <tfoot>
                                            <tr class="table-info">
                                                <th colspan="3">Total HT</th>
                                                <th class="text-end" id="montant-ht">0,00 €</th>
                                                <th></th>
                                            </tr>
                                            <tr class="table-info">
                                                <th colspan="3">TVA</th>
                                                <th class="text-end" id="montant-tva">0,00 €</th>
                                                <th></th>
                                            </tr>
                                            <tr class="table-success">
                                                <th colspan="3">Total TTC</th>
                                                <th class="text-end" id="montant-ttc">0,00 €</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                                <div id="no-articles" class="text-center text-muted py-4">
                                    <i class="fas fa-box-open fa-2x mb-2"></i>
                                    <p class="mb-0">Aucun article dans cette commande.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Commentaire -->
                        <div class="form-group mb-4">
                            <label asp-for="Input.Commentaire" class="form-label"></label>
                            <textarea asp-for="Input.Commentaire" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Input.Commentaire" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i> Enregistrer les modifications
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal ajout article -->
<div class="modal fade" id="articleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>Ajouter un article</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="article-select" class="form-label">Article</label>
                            <select id="article-select" class="form-select">
                                <option value="">-- Sélectionner un article --</option>
                                @foreach (var a in Model.ArticlesDisponibles)
                                {
                                    <option value="@a.Id"
                                            data-prix="@a.PrixUnitaireHT.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-tva="@a.TauxTVA.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-stock="@a.StockDisponible"
                                            data-nom="@a.Libelle">
                                        @a.Libelle - @a.PrixUnitaireHT.ToString("C")
                                    </option>
                                }
                            </select>
                            <div class="invalid-feedback">Veuillez sélectionner un article.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="quantite" class="form-label">Quantité</label>
                            <input type="number" id="quantite" class="form-control" min="1" value="1">
                            <div class="invalid-feedback">Quantité invalide.</div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Prix unitaire HT</label>
                            <input type="text" id="prix-unitaire" class="form-control" readonly>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="form-label">Stock disponible</label>
                            <input type="text" id="stock-disponible" class="form-control" readonly>
                        </div>
                    </div>
                </div>
                <div class="alert alert-info mb-0">
                    <strong>Montant ligne HT :</strong> <span id="montant-ligne-preview">0,00 €</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" onclick="addArticle()">
                    <i class="fas fa-plus me-1"></i> Ajouter
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            // Lignes existantes chargées depuis la BDD
            let lignes = @Html.Raw(Model.LignesJson);

            const select = document.getElementById('article-select');
            const quantiteInput = document.getElementById('quantite');
            const prixInput = document.getElementById('prix-unitaire');
            const stockInput = document.getElementById('stock-disponible');
            const previewSpan = document.getElementById('montant-ligne-preview');
            const form = document.getElementById('commandeForm');
            const hiddenJson = document.getElementById('lignesJsonInput');

            const fmt = (n) => n.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

            // ----- Modal -----
            window.openArticleModal = function () {
                select.value = '';
                quantiteInput.value = 1;
                prixInput.value = '';
                stockInput.value = '';
                previewSpan.textContent = fmt(0);
                new bootstrap.Modal(document.getElementById('articleModal')).show();
            };

            select.addEventListener('change', function () {
                const opt = select.options[select.selectedIndex];
                prixInput.value = opt.dataset.prix ? fmt(parseFloat(opt.dataset.prix)) : '';
                stockInput.value = opt.dataset.stock || '';
                updatePreview();
            });

            quantiteInput.addEventListener('input', updatePreview);

            function updatePreview() {
                const opt = select.options[select.selectedIndex];
                const prix = parseFloat(opt?.dataset.prix || 0);
                const qte = parseInt(quantiteInput.value) || 0;
                previewSpan.textContent = fmt(prix * qte);
            }

            // ----- Ajout -----
            window.addArticle = function () {
                const opt = select.options[select.selectedIndex];
                const qte = parseInt(quantiteInput.value) || 0;
                const stock = parseInt(opt?.dataset.stock || 0);
                let valid = true;

                if (!select.value) { select.classList.add('is-invalid'); valid = false; }
                else select.classList.remove('is-invalid');

                if (qte < 1) { quantiteInput.classList.add('is-invalid'); valid = false; }
                else quantiteInput.classList.remove('is-invalid');

                if (!valid) return;

                if (qte > stock) {
                    alert(`Stock insuffisant (disponible : ${stock}).`);
                    return;
                }

                const articleId = parseInt(select.value);
                const existing = lignes.find(l => l.ArticleId === articleId || l.articleId === articleId);

                if (existing) {
                    const q = (existing.Quantite ?? existing.quantite) + qte;
                    existing.Quantite = existing.quantite = q;
                    existing.MontantLigne = existing.montantLigne = q * parseFloat(opt.dataset.prix);
                } else {
                    const prix = parseFloat(opt.dataset.prix);
                    lignes.push({
                        ArticleId: articleId,
                        ArticleNom: opt.dataset.nom,
                        Quantite: qte,
                        PrixUnitaire: prix,
                        TauxTVA: parseFloat(opt.dataset.tva),
                        MontantLigne: qte * prix
                    });
                }

                render();
                bootstrap.Modal.getInstance(document.getElementById('articleModal')).hide();
            };

            window.removeLigne = function (index) {
                lignes.splice(index, 1);
                render();
            };

            // ----- Rendu -----
            function render() {
                const tbody = document.getElementById('articles-tbody');
                const noArt = document.getElementById('no-articles');
                tbody.innerHTML = '';

                lignes.forEach((l, i) => {
                    const nom = l.ArticleNom ?? l.articleNom;
                    const qte = l.Quantite ?? l.quantite;
                    const prix = l.PrixUnitaire ?? l.prixUnitaire;
                    const montant = l.MontantLigne ?? l.montantLigne;

                    tbody.insertAdjacentHTML('beforeend', `
                        <tr>
                            <td>${escapeHtml(nom)}</td>
                            <td class="text-end">${qte}</td>
                            <td class="text-end">${fmt(prix)}</td>
                            <td class="text-end">${fmt(montant)}</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeLigne(${i})">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>`);
                });

                noArt.style.display = lignes.length ? 'none' : 'block';
                updateTotaux();
            }

            function updateTotaux() {
                const ht = lignes.reduce((s, l) => s + (l.MontantLigne ?? l.montantLigne), 0);
                const tva = lignes.reduce((s, l) => s + (l.MontantLigne ?? l.montantLigne) * ((l.TauxTVA ?? 0) / 100), 0);
                document.getElementById('montant-ht').textContent = fmt(ht);
                document.getElementById('montant-tva').textContent = fmt(tva);
                document.getElementById('montant-ttc').textContent = fmt(ht + tva);
            }

            function escapeHtml(str) {
                const d = document.createElement('div');
                d.textContent = str ?? '';
                return d.innerHTML;
            }

            // ----- Soumission -----
            form.addEventListener('submit', function (e) {
                if (lignes.length === 0) {
                    e.preventDefault();
                    alert('Ajoutez au moins un article à la commande.');
                    return;
                }
                hiddenJson.value = JSON.stringify(lignes.map(l => ({
                    ArticleId: l.ArticleId ?? l.articleId,
                    Quantite: l.Quantite ?? l.quantite,
                    PrixUnitaire: l.PrixUnitaire ?? l.prixUnitaire,
                    TauxTVA: l.TauxTVA ?? 0,
                    MontantLigne: l.MontantLigne ?? l.montantLigne
                })));
            });

            render();
        })();
    </script>
}