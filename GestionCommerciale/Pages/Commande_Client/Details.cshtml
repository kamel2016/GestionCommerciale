@page
@using GestionCommerciale.Enums
@model GestionCommerciale.Pages.Commande_Client.DetailsModel
@{
    ViewData["Title"] = "Détail Commande";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-eye me-2"></i>
                        Détail de la Commande @Model.CommandeClient.NumeroCommande
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Informations Générales</h6>
                                </div>
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CommandeClient.NumeroCommande)</dt>
                                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CommandeClient.NumeroCommande)</dd>
                                        
                                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CommandeClient.DateCommande)</dt>
                                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CommandeClient.DateCommande)</dd>
                                        
                                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CommandeClient.DateLivraison)</dt>
                                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CommandeClient.DateLivraison)</dd>
                                        
                                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CommandeClient.Statut)</dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-@(Model.CommandeClient.Statut == StatutCommande.EnAttente ? "warning" : 
                                                                   Model.CommandeClient.Statut == StatutCommande.Confirmee ? "success" : 
                                                                   Model.CommandeClient.Statut == StatutCommande.Livree ? "primary" : "danger")">
                                                @Html.DisplayFor(model => model.CommandeClient.Statut)
                                            </span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Informations Client</h6>
                                </div>
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">Client</dt>
                                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CommandeClient.Client.Nom)</dd>
                                        
                                        <dt class="col-sm-4">Email</dt>
                                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CommandeClient.Client.Email)</dd>
                                        
                                        <dt class="col-sm-4">Téléphone</dt>
                                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CommandeClient.Client.Telephone)</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CommandeClient.Commentaire))
                    {
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Commentaire</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-0">@Html.DisplayFor(model => model.CommandeClient.Commentaire)</p>
                            </div>
                        </div>
                    }

                    <!-- Articles de la commande -->
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">Articles de la commande</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Article</th>
                                            <th>Quantité</th>
                                            <th>Prix Unitaire</th>
                                            <th>Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ligne in Model.CommandeClient.LignesCommande)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => ligne.Article.Libelle)</td>
                                                <td>@Html.DisplayFor(modelItem => ligne.Quantite)</td>
                                                <td>@Html.DisplayFor(modelItem => ligne.PrixUnitaire)</td>
                                                <td>@Html.DisplayFor(modelItem => ligne.MontantLigne)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="table-info">
                                            <th colspan="3">Total HT</th>
                                            <th>@Html.DisplayFor(model => model.CommandeClient.MontantHT)</th>
                                        </tr>
                                        <tr class="table-info">
                                            <th colspan="3">TVA</th>
                                            <th>@Html.DisplayFor(model => model.CommandeClient.MontantTVA)</th>
                                        </tr>
                                        <tr class="table-success">
                                            <th colspan="3">Total TTC</th>
                                            <th>@Html.DisplayFor(model => model.CommandeClient.MontantTTC)</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="./Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>
                            Retour à la liste
                        </a>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@Model.CommandeClient.Id" class="btn btn-primary me-2">
                                <i class="fas fa-edit me-1"></i>
                                Modifier
                            </a>
                            <button type="button" class="btn btn-success" onclick="window.print()">
                                <i class="fas fa-print me-1"></i>
                                Imprimer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>