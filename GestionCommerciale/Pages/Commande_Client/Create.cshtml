@page
@model GestionCommerciale.Pages.Commande_Client.CreateModel
@{
    ViewData["Title"] = "Créer une commande client";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>
                        Nouvelle commande client
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post" id="commande-form">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- Informations générales -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="CommandeClient.NumeroCommande" class="form-label"></label>
                                    <input asp-for="CommandeClient.NumeroCommande" class="form-control" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="CommandeClient.DateCommande" class="form-label"></label>
                                    <input asp-for="CommandeClient.DateCommande" class="form-control" type="date" />
                                    <span asp-validation-for="CommandeClient.DateCommande" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="CommandeClient.ClientId" class="form-label"></label>
                                    <select asp-for="CommandeClient.ClientId" asp-items="Model.Clients" class="form-select">
                                        <option value="">-- Sélectionner un client --</option>
                                    </select>
                                    <span asp-validation-for="CommandeClient.ClientId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="CommandeClient.DateLivraison" class="form-label"></label>
                                    <input asp-for="CommandeClient.DateLivraison" class="form-control" type="date" />
                                </div>
                            </div>
                        </div>

                        <!-- Articles -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="mb-0"><i class="fas fa-boxes me-2"></i>Articles</h5>
                                    <button type="button" class="btn btn-success btn-sm" onclick="openArticleModal()">
                                        <i class="fas fa-plus me-1"></i> Ajouter un article
                                    </button>
                                </div>

                                <div class="table-responsive" id="articles-container">
                                    <table class="table table-hover align-middle" id="articles-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Article</th>
                                                <th class="text-end">Prix unitaire</th>
                                                <th class="text-center">Quantité</th>
                                                <th class="text-end">Montant HT</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="articles-tbody"></tbody>
                                    </table>
                                </div>

                                <div id="no-articles" class="text-center text-muted py-4">
                                    <i class="fas fa-box-open fa-3x mb-3"></i>
                                    <p>Aucun article ajouté. Cliquez sur « Ajouter un article » pour commencer.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Totaux -->
                        <div class="row mb-4">
                            <div class="col-md-6 offset-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-6"><strong>Montant HT :</strong></div>
                                            <div class="col-6 text-end" id="montant-ht">0,00 €</div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-6"><strong>TVA :</strong></div>
                                            <div class="col-6 text-end" id="montant-tva">0,00 €</div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-6"><strong>Montant TTC :</strong></div>
                                            <div class="col-6 text-end fw-bold text-primary" id="montant-ttc">0,00 €</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Commentaire -->
                        <div class="form-group mb-4">
                            <label asp-for="CommandeClient.Commentaire" class="form-label"></label>
                            <textarea asp-for="CommandeClient.Commentaire" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="CommandeClient.Commentaire" class="text-danger"></span>
                        </div>

                        <!-- Données des lignes (sérialisées par JS) -->
                        <input type="hidden" asp-for="LignesJson" id="lignes-json" />

                        <!-- Boutons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" id="btn-submit">
                                <i class="fas fa-save me-1"></i> Créer la commande
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal ajout article -->
<div class="modal fade" id="articleModal" tabindex="-1" aria-labelledby="articleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="articleModalLabel">
                    <i class="fas fa-plus-circle me-2"></i>Ajouter un article
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="article-select" class="form-label">Article</label>
                            <select id="article-select" class="form-select">
                                <option value="">-- Sélectionner un article --</option>
                                @foreach (var a in Model.Articles)
                                {
                                    <option value="@a.Id"
                                            data-prix="@a.Prix.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-tva="@a.TauxTVA.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-stock="@a.Stock"
                                            data-nom="@a.Nom">
                                        @a.Nom - @a.Prix.ToString("N2") €
                                    </option>
                                }
                            </select>
                            <div class="invalid-feedback">Veuillez sélectionner un article.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="quantite" class="form-label">Quantité</label>
                            <input type="number" id="quantite" class="form-control" min="1" value="1" />
                            <div class="invalid-feedback">Veuillez saisir une quantité valide.</div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="prix-unitaire" class="form-label">Prix unitaire HT</label>
                            <input type="text" id="prix-unitaire" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="stock-disponible" class="form-label">Stock disponible</label>
                            <input type="text" id="stock-disponible" class="form-control" readonly />
                        </div>
                    </div>
                </div>
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Montant ligne HT :</strong> <span id="montant-ligne-preview">0,00 €</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="btn-add-article">
                    <i class="fas fa-plus me-1"></i> Ajouter
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/commande-create.js" asp-append-version="true"></script>
}