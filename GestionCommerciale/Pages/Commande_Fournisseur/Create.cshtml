@page
@model GestionCommerciale.Pages.Commande_Fournisseur.CreateModel
@{
    ViewData["Title"] = "Créer une commande fournisseur";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-truck me-2"></i>
                        Nouvelle commande fournisseur
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post" id="commandeForm">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="CommandeFournisseur.NumeroCommande" class="form-label"></label>
                                <input asp-for="CommandeFournisseur.NumeroCommande" class="form-control" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CommandeFournisseur.DateCommande" class="form-label"></label>
                                <input asp-for="CommandeFournisseur.DateCommande" class="form-control" type="date" />
                                <span asp-validation-for="CommandeFournisseur.DateCommande" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="CommandeFournisseur.FournisseurId" class="form-label"></label>
                                <select asp-for="CommandeFournisseur.FournisseurId" asp-items="Model.Fournisseurs" class="form-select">
                                    <option value="">-- Sélectionner un fournisseur --</option>
                                </select>
                                <span asp-validation-for="CommandeFournisseur.FournisseurId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CommandeFournisseur.DateLivraisonPrevue" class="form-label"></label>
                                <input asp-for="CommandeFournisseur.DateLivraisonPrevue" class="form-control" type="date" />
                                <span asp-validation-for="CommandeFournisseur.DateLivraisonPrevue" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Articles -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">Articles commandés</h5>
                                    <button type="button" class="btn btn-success btn-sm" onclick="openArticleModal()">
                                        <i class="fas fa-plus me-1"></i> Ajouter un article
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Article</th>
                                                <th>Quantité</th>
                                                <th>Prix unitaire HT</th>
                                                <th>Montant HT</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="articles-tbody"></tbody>
                                    </table>
                                </div>
                                <div id="no-articles" class="text-center text-muted py-4">
                                    <i class="fas fa-box-open fa-3x mb-3"></i>
                                    <p>Aucun article ajouté. Cliquez sur « Ajouter un article » pour commencer.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Totaux -->
                        <div class="row mb-4">
                            <div class="col-md-6 offset-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-6"><strong>Montant HT :</strong></div>
                                            <div class="col-6 text-end" id="montant-ht">0,00 €</div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-6"><strong>TVA (20 %) :</strong></div>
                                            <div class="col-6 text-end" id="montant-tva">0,00 €</div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-6"><strong>Montant TTC :</strong></div>
                                            <div class="col-6 text-end fw-bold text-primary" id="montant-ttc">0,00 €</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CommandeFournisseur.Commentaire" class="form-label"></label>
                            <textarea asp-for="CommandeFournisseur.Commentaire" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Créer la commande
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal ajout article -->
<div class="modal fade" id="articleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>Ajouter un article</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="article-form">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="article-select" class="form-label">Article</label>
                            <select id="article-select" class="form-select">
                                <option value="">-- Sélectionner un article --</option>
                                @foreach (var a in Model.Articles)
                                {
                                    <option value="@a.ID"
                                            data-nom="@a.Libelle"
                                            data-prix="@a.PrixAchatHT.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        @a.Libelle (@a.PrixAchatHT.ToString("C"))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="quantite" class="form-label">Quantité</label>
                            <input type="number" id="quantite" class="form-control" min="1" value="1">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="prix-unitaire" class="form-label">Prix unitaire HT</label>
                            <input type="number" id="prix-unitaire" class="form-control" step="0.01" min="0">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Montant ligne HT</label>
                            <input type="text" id="montant-ligne-preview" class="form-control" readonly value="0,00 €">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" onclick="addArticle()">
                    <i class="fas fa-plus me-1"></i> Ajouter
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let commandeArticles = [];

        function openArticleModal() {
            document.getElementById('article-form').reset();
            document.getElementById('montant-ligne-preview').value = '0,00 €';
            new bootstrap.Modal(document.getElementById('articleModal')).show();
        }

        document.getElementById('article-select').addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            document.getElementById('prix-unitaire').value = opt.value ? parseFloat(opt.dataset.prix).toFixed(2) : '';
            updateMontantPreview();
        });

        document.getElementById('quantite').addEventListener('input', updateMontantPreview);
        document.getElementById('prix-unitaire').addEventListener('input', updateMontantPreview);

        function updateMontantPreview() {
            const q = parseInt(document.getElementById('quantite').value) || 0;
            const p = parseFloat(document.getElementById('prix-unitaire').value) || 0;
            document.getElementById('montant-ligne-preview').value = (q * p).toFixed(2) + ' €';
        }

        function addArticle() {
            const select = document.getElementById('article-select');
            const quantite = parseInt(document.getElementById('quantite').value);
            const prix = parseFloat(document.getElementById('prix-unitaire').value);

            if (!select.value || !quantite || quantite < 1 || isNaN(prix)) {
                alert('Veuillez renseigner l\'article, la quantité et le prix.');
                return;
            }

            const articleId = parseInt(select.value);
            const existing = commandeArticles.find(a => a.articleId === articleId);

            if (existing) {
                existing.quantite += quantite;
                existing.montantLigne = existing.quantite * existing.prixUnitaire;
            } else {
                commandeArticles.push({
                    articleId: articleId,
                    nom: select.options[select.selectedIndex].dataset.nom,
                    quantite: quantite,
                    prixUnitaire: prix,
                    montantLigne: quantite * prix
                });
            }

            render();
            bootstrap.Modal.getInstance(document.getElementById('articleModal')).hide();
        }

        function removeArticle(index) {
            commandeArticles.splice(index, 1);
            render();
        }

        function render() {
            const tbody = document.getElementById('articles-tbody');
            const noArticles = document.getElementById('no-articles');

            // Supprime les champs cachés précédents
            document.querySelectorAll('input[name^="LignesCommande"]').forEach(i => i.remove());

            if (commandeArticles.length === 0) {
                tbody.innerHTML = '';
                noArticles.style.display = 'block';
            } else {
                noArticles.style.display = 'none';
                tbody.innerHTML = commandeArticles.map((a, i) => `
                    <tr>
                        <td>${a.nom}</td>
                        <td>${a.quantite}</td>
                        <td>${a.prixUnitaire.toFixed(2)} €</td>
                        <td>${a.montantLigne.toFixed(2)} €</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeArticle(${i})">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>`).join('');

                const form = document.getElementById('commandeForm');
                commandeArticles.forEach((a, i) => {
                    addHidden(form, `LignesCommande[${i}].ArticleId`, a.articleId);
                    addHidden(form, `LignesCommande[${i}].Quantite`, a.quantite);
                    addHidden(form, `LignesCommande[${i}].PrixUnitaire`, a.prixUnitaire);
                    addHidden(form, `LignesCommande[${i}].MontantLigne`, a.montantLigne);
                });
            }

            updateTotaux();
        }

        function addHidden(form, name, value) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
        }

        function updateTotaux() {
            const ht = commandeArticles.reduce((s, a) => s + a.montantLigne, 0);
            const tva = ht * 0.20;
            document.getElementById('montant-ht').textContent = ht.toFixed(2) + ' €';
            document.getElementById('montant-tva').textContent = tva.toFixed(2) + ' €';
            document.getElementById('montant-ttc').textContent = (ht + tva).toFixed(2) + ' €';
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}