@page "{id:int}"
@using GestionCommerciale.Enums
@model GestionCommerciale.Pages.Commande_Fournisseur.DeleteModel
@{
    ViewData["Title"] = "Supprimer commande fournisseur";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var c = Model.CommandeFournisseur;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-trash me-2"></i>
                        Supprimer la commande
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Attention !</strong> Êtes-vous sûr de vouloir supprimer cette commande fournisseur ? Cette action est irréversible.
                    </div>

                    @if (Model.NombreBonsReception > 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-ban me-2"></i>
                            Cette commande possède @Model.NombreBonsReception bon(s) de réception : la suppression sera refusée.
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Informations de la commande</h6>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Numéro</dt>
                                        <dd class="col-sm-7">@c.NumeroCommande</dd>

                                        <dt class="col-sm-5">Date commande</dt>
                                        <dd class="col-sm-7">@c.DateCommande.ToString("dd/MM/yyyy")</dd>

                                        <dt class="col-sm-5">Fournisseur</dt>
                                        <dd class="col-sm-7">@c.Fournisseur.Nom</dd>

                                        <dt class="col-sm-5">Statut</dt>
                                        <dd class="col-sm-7">
                                            @switch (c.Statut)
                                            {
                                                case StatutCommande.EnAttente:
                                                    <span class="badge bg-warning">En attente</span>
                                                    break;
                                                case StatutCommande.EnPreparation:
                                                    <span class="badge bg-primary">En cours</span>
                                                    break;
                                                case StatutCommande.Livree:
                                                    <span class="badge bg-success">Livrée</span>
                                                    break;
                                                case StatutCommande.Annulee:
                                                    <span class="badge bg-danger">Annulée</span>
                                                    break;
                                            }
                                        </dd>

                                        <dt class="col-sm-5">Montant TTC</dt>
                                        <dd class="col-sm-7">@c.MontantTTC.ToString("C")</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Articles (@c.LignesCommande.Count)</h6>
                                </div>
                                <div class="card-body">
                                    @if (c.LignesCommande.Any())
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var ligne in c.LignesCommande)
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                    <div>
                                                        <strong>@ligne.Article.Libelle</strong><br>
                                                        <small class="text-muted">
                                                            Qté : @ligne.Quantite × @ligne.PrixUnitaire.ToString("C")
                                                        </small>
                                                    </div>
                                                    <span class="badge bg-primary">@ligne.MontantLigne.ToString("C")</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">Aucun article</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <form method="post" class="mt-4">
                        <input type="hidden" name="id" value="@c.Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                            </a>
                            <button type="submit" class="btn btn-danger" @(Model.NombreBonsReception > 0 ? "disabled" : "")>
                                <i class="fas fa-trash me-1"></i> Confirmer la suppression
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>